# ------------------------------------------------------------------
# AI IT Support Assistant - environment configuration
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# NEVER commit the real .env file and never hard-code API keys.
# Get Cohere API keys at https://dashboard.cohere.com/api-keys
# ------------------------------------------------------------------

# ----- Primary LLM configuration (required) -----
COHERE_API_KEY_PRIMARY=
COHERE_PRIMARY_MODEL=command-a-plus-05-2026

# ----- Fallback LLM configuration (optional) -----
# Used automatically when the primary request fails (auth error, rate limit,
# timeout, provider failure, ...). Keys are not tied to models: either key
# may call either model.
COHERE_API_KEY_FALLBACK=
COHERE_FALLBACK_MODEL=command-a-03-2025

# ----- Optional overrides -----
# LLM_TIMEOUT_SECONDS=30
# DATABASE_URL=sqlite:///./it_support.db
