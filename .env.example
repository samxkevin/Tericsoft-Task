# ------------------------------------------------------------------
# AI IT Support Assistant - environment configuration
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# NEVER commit the real .env file and never hard-code API keys.
# Both providers below have free tiers; paid services are not required.
# ------------------------------------------------------------------

# Which LLM provider to use: "gemini" (default) or "groq"
LLM_PROVIDER=gemini

# Free Google Gemini API key - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free Groq API key - get one at https://console.groq.com/keys
# Only needed when LLM_PROVIDER=groq
GROQ_API_KEY=

# ----- Optional overrides (defaults shown) -----
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_TIMEOUT_SECONDS=30
# DATABASE_URL=sqlite:///./it_support.db
